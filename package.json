    "impact:alrs:r4:substantive": "node scripts/build-alrs-substantive-review-queue.mjs",
    "impact:alrs:r4:p1": "node scripts/build-alrs-p1-substantive-pack.mjs",
    "orch:setup": "bash scripts/orchestrator/setup-local.sh",
    "orch:doctor": "bash scripts/orchestrator/doctor.sh",
    "orch:install-skill": "bash scripts/orchestrator/install-hermes-skill.sh",
    "orch:sync-gateway-node": "bash scripts/orchestrator/sync-gateway-node.sh",
    "orch:configure-google": "bash scripts/orchestrator/configure-antigravity-readonly.sh",
    "orch:opencode": "bash scripts/orchestrator/run-opencode.sh",
    "orch:free": "bash scripts/orchestrator/run-free-pool.sh",
    "orch:google": "bash scripts/orchestrator/run-antigravity.sh",
    "orch:gemini-legacy": "bash scripts/orchestrator/run-gemini.sh",
    "orch:codex": "bash scripts/orchestrator/run-codex-readonly.sh",
    "orch:local": "bash scripts/orchestrator/run-local-fallback.sh"
