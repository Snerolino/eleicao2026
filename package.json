{
  "name": "portal-transparencia-rs",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "data:refresh": "node scripts/refresh-public-snapshot.mjs",
    "data:photos": "node scripts/apply-official-candidate-photos.mjs",
    "data:check": "node scripts/data-check.mjs",
    "env:check": "node scripts/build-env-check.mjs",
    "build": "npm run data:check && tsc -b && vite build && node scripts/generate-sitemap.mjs && node scripts/generate-release-metadata.mjs",
    "build:deploy": "npm run env:check -- --require-supabase && npm run build",
    "preview": "vite preview",
    "smoke:local": "node scripts/smoke-browser.mjs --start-preview --url http://127.0.0.1:4173/",
    "smoke:preview": "node scripts/smoke-browser.mjs",
    "health:preview": "node scripts/health-check.mjs",
    "security:audit": "bash -lc 'npm audit --omit=dev --audit-level=high'",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@supabase/supabase-js": "^2.49.1",
    "@tanstack/react-query": "^5.101.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.1",
    "lucide-react": "^1.26.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.10"
  }
}
