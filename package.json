    "impact:camara:sources:apply": "node scripts/apply-camara-q1-sources.mjs",
    "impact:camara:apply": "node scripts/apply-camara-q1-resolved.mjs",
    "impact:senado:sources:apply": "node scripts/apply-senado-nominal-sources.mjs",
    "impact:senado:envelope:adapt": "node scripts/adapt-senado-nominal-envelope.mjs",
