{
  "$schema": "https://opencode.ai/config.json",

  // OpenCode deixa de ser o writer principal. O caminho orquestrado usa o
  // agent plan com modelos gratuitos para triagem/revisão de conteúdo público.
  "model": "opencode/deepseek-v4-flash-free",

  "agent": {
    "plan": {
      "model": "opencode/deepseek-v4-flash-free",
      "fallback": [
        "opencode/nemotron-3-ultra-free",
        "opencode/laguna-s-2.1-free",
        "opencode/ling-3.0-tiny-free",
        "opencode/mimo-v2.5-free",
        "ollama/gpt-oss:20b"
      ],
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "external_directory": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "**/.env": "deny",
          "**/.env.*": "deny",
          "data/tse-archive/**": "deny"
        }
      }
    },

    // Compatibilidade manual somente. A arquitetura v1 não roteia escrita para
    // este agent automaticamente; Codex MCP é o writer técnico preferido.
    "build": {
      "model": "openai/gpt-5.5",
      "fallback": [
        "opencode/deepseek-v4-flash-free",
        "opencode/nemotron-3-ultra-free",
        "ollama/gpt-oss:20b"
      ],
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "ask",
          "git push *": "deny",
          "git commit *": "deny",
          "git merge *": "deny",
          "gh pr merge *": "deny",
          "npx supabase db push *": "deny",
          "npx supabase migration up *": "deny",
          "npx wrangler pages deploy *": "deny"
        },
        "external_directory": "deny"
      }
    }
  },

  "lsp": {
    "typescript": {
      "enabled": true,
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx"]
    },
    "javascript": {
      "enabled": true,
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".js", ".jsx"]
    },
    "tailwindcss": {
      "enabled": true,
      "command": ["@tailwindcss/language-server", "--stdio"],
      "extensions": [".jsx", ".tsx", ".html"]
    }
  },

  // MCP do OpenCode não participa do caminho gratuito orquestrado
  // (`OPENCODE_DISABLE_MCP=true` no wrapper). Mantemos apenas o filesystem
  // curado disponível para uso interativo; banco remoto e opencode-mcp ficam off.
  "mcp": {
    "servers": {
      "enabled": true,
      "supabase": {
        "type": "local",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-postgres"],
        "env": {
          "DATABASE_URL": "{env:SUPABASE_DATABASE_URL}"
        },
        "enabled": false
      },
      "filesystem": {
        "type": "local",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-filesystem", "docs/context-export"],
        "enabled": true
      },
      "opencode": {
        "type": "local",
        "command": "npx",
        "args": ["-y", "opencode-mcp"],
        "enabled": false
      }
    }
  },

  "instructions": [
    "AGENTS.md",
    ".orchestrator/README.md",
    ".orchestrator/STATE.md",
    "README.md"
  ]
}
