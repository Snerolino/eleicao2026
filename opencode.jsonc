{
  "$schema": "https://opencode.ai/config.json",

  // O caminho orquestrado usa OpenCode somente como leitor/analista barato.
  // Fallback entre provedores pertence ao Hermes, não a uma segunda cadeia aqui.
  "model": "opencode/deepseek-v4-flash-free",
  "default_agent": "plan",
  "share": "disabled",

  "agent": {
    "plan": {
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "external_directory": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "**/.env": "deny",
          "**/.env.*": "deny",
          "data/tse-archive/**": "deny"
        }
      }
    },

    // Compatibilidade para uso humano interativo. A arquitetura Hermes v1 não
    // roteia mutações automaticamente para OpenCode; Codex MCP é o writer.
    "build": {
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "ask",
          "git push *": "deny",
          "git commit *": "deny",
          "git merge *": "deny",
          "gh pr merge *": "deny",
          "npx supabase db push *": "deny",
          "npx supabase migration up *": "deny",
          "npx wrangler pages deploy *": "deny"
        },
        "external_directory": "deny"
      }
    }
  },

  "lsp": {
    "typescript": {
      "enabled": true,
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx"]
    },
    "javascript": {
      "enabled": true,
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".js", ".jsx"]
    },
    "tailwindcss": {
      "enabled": true,
      "command": ["@tailwindcss/language-server", "--stdio"],
      "extensions": [".jsx", ".tsx", ".html"]
    }
  },

  // Sem MCP no OpenCode desta arquitetura. Menos ferramentas = menos contexto,
  // menos superfície de segredo e um comportamento read-only previsível.
  "mcp": {},

  "instructions": [
    "AGENTS.md",
    ".orchestrator/README.md",
    ".orchestrator/STATE.md",
    "README.md"
  ]
}
