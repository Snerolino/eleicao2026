{
  "$schema": "https://opencode.ai/config.json",
  // ===== Modelo padrão =====
  // MOA (2026-08-08): prioridade paga→grátis→local.
  // Pagedos (credenciados primeiro), deps pois exigem billing não estão na
  // chain default. Gratuitos do OpenCode Zen + ollama local como backup offline.
  "model": "openai/gpt-5.5",
  "agent": {
    "build": {
      "model": "openai/gpt-5.5",
      "fallback": [
        "google/gemini-3.5-flash",
        "cloudflare-ai-gateway/openai/gpt-4o-mini",
        "opencode/deepseek-v4-flash-free",
        "opencode/nemotron-3-ultra-free",
        "opencode/laguna-s-2.1-free",
        "opencode/ling-3.0-tiny-free",
        "opencode/mimo-v2.5-free",
        "ollama/gpt-oss:20b"
      ]
    },
    "plan": {
      "model": "opencode/deepseek-v4-flash-free",
      "fallback": [
        "opencode/nemotron-3-ultra-free",
        "google/gemini-3.5-flash",
        "cloudflare-ai-gateway/openai/gpt-4o-mini",
        "opencode/laguna-s-2.1-free",
        "opencode/ling-3.0-tiny-free",
        "opencode/mimo-v2.5-free",
        "ollama/gpt-oss:20b"
      ]
    }
  },

  // ===== LSP =====
  "lsp": {
    "typescript": {
      "enabled": true,
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx"]
    },
    "javascript": {
      "enabled": true,
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".js", ".jsx"]
    },
    "tailwindcss": {
      "enabled": true,
      "command": ["@tailwindcss/language-server", "--stdio"],
      "extensions": [".jsx", ".tsx", ".html"]
    }
  },

  // ===== MCP =====
  "mcp": {
    "servers": {
      // Habilita/desabilita todos os servidores MCP
      "enabled": true,

      // Supabase (via PostgreSQL). DATABASE_URL vem do ambiente; nunca commitar valor real.
      "supabase": {
        "type": "local",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-postgres"],
        "env": {
          "DATABASE_URL": "{env:SUPABASE_DATABASE_URL}"
        },
        "enabled": true
      },

      // Sistema de arquivos curado para ponte com o raspador: nunca apontar para ".".
      "filesystem": {
        "type": "local",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-filesystem", "docs/context-export"],
        "enabled": true
      },

      // OpenCode MCP (ferramentas extras)
      "opencode": {
        "type": "local",
        "command": "npx",
        "args": ["-y", "opencode-mcp"],
        "enabled": true
      }
    }
  },

  // Instruções para agentes
  "instructions": ["AGENTS.md", "README.md"]
}
