{
  "$schema": "https://opencode.ai/config.json",

  // O smoke e o wrapper direto usam a rota OpenAI autenticada solicitada.
  // O pool gratuito permanece separado em run-free-pool.sh.
  "model": "openai/gpt-5.6-luna",
  "default_agent": "plan",
  "share": "disabled",

  "agent": {
    "plan": {
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "external_directory": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "**/.env": "deny",
          "**/.env.*": "deny",
          "data/tse-archive/**": "deny"
        }
      }
    },

    // OpenCode não é writer nesta arquitetura. Se alguém selecionar build
    // interativamente na worktree viva, nenhuma ferramenta é concedida ao
    // modelo gratuito. Mutações locais pertencem ao Codex MCP autorizado.
    "build": {
      "permission": {
        "*": "deny"
      }
    }
  },

  "lsp": {
    "typescript": {
      "enabled": true,
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".ts", ".tsx"]
    },
    "javascript": {
      "enabled": true,
      "command": ["typescript-language-server", "--stdio"],
      "extensions": [".js", ".jsx"]
    },
    "tailwindcss": {
      "enabled": true,
      "command": ["@tailwindcss/language-server", "--stdio"],
      "extensions": [".jsx", ".tsx", ".html"]
    }
  },

  // Sem MCP no OpenCode desta arquitetura. Menos ferramentas = menos contexto,
  // menos superfície de segredo e um comportamento read-only previsível.
  "mcp": {},

  "instructions": []
}
