# Portal Transparência Eleitoral RS — variáveis de ambiente

# Supabase (obrigatório para dados reais; sem elas, o site usa mockData)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbG...aqui

# Build/deploy
# PRs podem buildar sem Supabase usando data/public-candidates.json.
# Deploy de main usa npm run build:deploy e exige VITE_SUPABASE_* com formato válido.
# Nunca configure service_role em variáveis VITE_* ou no ambiente de build.
PUBLIC_CANDIDATES_MIN_COUNT=69

# Cloudflare (deploy via wrangler)
# CLOUDFLARE_API_TOKEN=seu-token-pages-edit
